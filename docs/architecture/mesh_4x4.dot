graph Mesh4x4 {
    layout=neato;
    overlap=false;
    splines=line;

    node [shape=circle, width=0.65, fixedsize=true];

    // Node positions
    0  [pos="0,3!"];
    1  [pos="1,3!"];
    2  [pos="2,3!"];
    3  [pos="3,3!"];

    4  [pos="0,2!"];
    5  [pos="1,2!"];
    6  [pos="2,2!"];
    7  [pos="3,2!"];

    8  [pos="0,1!"];
    9  [pos="1,1!"];
    10 [pos="2,1!"];
    11 [pos="3,1!"];

    12 [pos="0,0!"];
    13 [pos="1,0!"];
    14 [pos="2,0!"];
    15 [pos="3,0!"];

    // Horizontal links
    0 -- 1;
    1 -- 2;
    2 -- 3;

    4 -- 5;
    5 -- 6;
    6 -- 7;

    8 -- 9;
    9 -- 10;
    10 -- 11;

    12 -- 13;
    13 -- 14;
    14 -- 15;

    // Vertical links
    0 -- 4;
    4 -- 8;
    8 -- 12;

    1 -- 5;
    5 -- 9;
    9 -- 13;

    2 -- 6;
    6 -- 10;
    10 -- 14;

    3 -- 7;
    7 -- 11;
    11 -- 15;
}